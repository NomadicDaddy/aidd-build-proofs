<!-- Pantry low-stock view: a flat, name-sorted list of items whose quantity is at or below their
     per-item reorder threshold. The list markup is produced by Format-PantryLowStockListHtml (see
     api/_lib/pantry-render.ps1) and passed in as $data.ListHtml so the full-page render and the htmx
     refresh fragment share one source of truth. The list wrapper (#lowstock-list) and the nav count
     re-fetch themselves on the body-level 'itemChanged' event that every create/edit/delete
     dispatches, so this view stays in sync without a full page reload. -->
<section class="bg-gray-50 p-3 sm:p-5 dark:bg-gray-900">
	<div class="mx-auto max-w-(--breakpoint-xl)">
		<div class="mb-2 flex items-center justify-between">
			<h1 class="text-2xl font-bold text-gray-800 dark:text-gray-200">Low stock</h1>
		</div>
		<p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
			Items at or below their reorder threshold (quantity is less than or equal to the item's low-stock threshold), sorted by name. Time to restock.
		</p>
		$($data.ListHtml ;)
	</div>
</section>

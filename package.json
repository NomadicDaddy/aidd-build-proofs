{
	"name": "aidd-build-proofs",
	"version": "1.0.0",
	"private": true,
	"description": "Public evidence from seven AIDD build proofs recorded in June and July 2026.",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.3.14",
		"eslint": "10.7.0",
		"eslint-plugin-perfectionist": "5.10.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.7.0",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24.0.0 <25.0.0"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"curate": "bun scripts/curate.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint scripts --report-unused-disable-directives --max-warnings 0",
		"package:transcripts": "bun scripts/package-transcripts.ts",
		"preinstall": "bun scripts/require-bun.ts",
		"smoke:qc": "bun run typecheck && bun test && bun run verify && bun run format:check",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"verify": "bun scripts/verify-evidence.ts"
	},
	"type": "module"
}
